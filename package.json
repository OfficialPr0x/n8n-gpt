{
  "name": "n8n-gpt",
  "version": "1.0.0",
  "type": "module",
  "description": "A modular GPT-based dev council that can trigger n8n workflows and connect via OpenAPI",
  "main": "server.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node dist/server.js",
    "build": "tsc",
    "test": "jest",
    "update-plugin": "node update-plugin-url.js",
    "render-build": "npm install && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.9.4",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
